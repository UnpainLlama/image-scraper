{
  "rules": [
    {
      "id": "Expire temporary scraper objects",
      "conditions": { "prefix": "tmp/" },
      "enabled": true,
      "deleteObjectsTransition": {
        "condition": { "type": "Age", "maxAge": 86400 }
      }
    },
    {
      "id": "Abort incomplete scraper multipart uploads",
      "conditions": { "prefix": "" },
      "enabled": true,
      "abortMultipartUploadsTransition": {
        "condition": { "type": "Age", "maxAge": 86400 }
      }
    }
  ]
}