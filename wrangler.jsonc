{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "image-scraper",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dashboard",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "browser": { "binding": "BROWSER" },
  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "image-scraper-archive" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "JOBS", "class_name": "JobDurableObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["JobDurableObject"] }
  ],
  "queues": {
    "producers": [
      { "binding": "DISCOVERY_QUEUE", "queue": "image-scraper-discovery" },
      { "binding": "DOWNLOAD_QUEUE", "queue": "image-scraper-download" }
    ],
    "consumers": [
      { "queue": "image-scraper-discovery", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 5, "max_concurrency": 5 },
      { "queue": "image-scraper-download", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 5, "max_concurrency": 5 }
    ]
  },
  "env": {
    "staging": {
      "name": "image-scraper-staging",
      "observability": {
        "enabled": true,
        "logs": {
          "enabled": true,
          "invocation_logs": false,
          "head_sampling_rate": 1,
          "redact_query_string": true
        },
        "traces": { "enabled": false }
      },
      "workers_dev": true,
      "assets": {
        "directory": "./dashboard",
        "binding": "ASSETS",
        "run_worker_first": true,
        "not_found_handling": "single-page-application"
      },
      "browser": { "binding": "BROWSER" },
      "r2_buckets": [
        { "binding": "IMAGES", "bucket_name": "image-scraper-staging" }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "JOBS", "class_name": "JobDurableObject" }
        ]
      },
      "queues": {
        "producers": [
          { "binding": "DISCOVERY_QUEUE", "queue": "image-scraper-staging-discovery" },
          { "binding": "DOWNLOAD_QUEUE", "queue": "image-scraper-staging-download" }
        ],
        "consumers": [
          { "queue": "image-scraper-staging-discovery", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 5, "max_concurrency": 5 },
          { "queue": "image-scraper-staging-download", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 5, "max_concurrency": 5 }
        ]
      }
    }
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1,
      "redact_query_string": true
    },
    "traces": { "enabled": false }
  }
}